STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Owner-controlled key for deliberate backend API testing. Generate at least 32 random characters.
HEART_MOBILE_INTERNAL_API_KEY=

# MobileSentrix OAuth 1.0 credentials (server-side only; do not prefix with NEXT_PUBLIC_)
MOBILESENTRIX_API_URL=https://mobilesentrix.ca
MOBILESENTRIX_CONSUMER_KEY=
MOBILESENTRIX_CONSUMER_SECRET=
MOBILESENTRIX_ACCESS_TOKEN=
MOBILESENTRIX_ACCESS_TOKEN_SECRET=

# Fail-closed feature gates. Keep false until credentials and official API behavior are verified.
MOBILESENTRIX_READS_ENABLED=false
MOBILESENTRIX_MUTATIONS_ENABLED=false
